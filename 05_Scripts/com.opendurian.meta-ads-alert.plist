<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.opendurian.meta-ads-alert</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/opendurian/Documents/Claude/Projects/Excel: Content KPI Dashboard/meta_ads_alert.py</string>
    </array>

    <!-- รันทุกวัน เวลา 09:00 น. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/tmp/meta_ads_alert.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/meta_ads_alert_error.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
